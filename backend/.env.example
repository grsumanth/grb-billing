# ── Server ──────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5000

# ── Supabase PostgreSQL ──────────────────
# Use the Session Pooler URL from Supabase Dashboard (port 6543) to avoid IPv6 timeout issues
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Supabase API ────────────────────────
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-backend-only

# ── Authentication & Security ────────────
JWT_SECRET=your-secure-jwt-secret-string
JWT_EXPIRES_IN=7d

# ── SMTP Email configurations ────────────
GMAIL_USER=your-app-email@gmail.com
GMAIL_PASS=your-gmail-app-password

# ── Google Drive Backup ──────────────────
# Service Account (used as fallback if OAuth2 vars below are not set)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared folder ID: Create a folder in your Google Drive, share it with the
# service account email above as Editor, and paste the folder ID here.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-folder-id

# OAuth2 (Recommended — avoids service account quota issues)
# Run: node oauth-helper.js to generate the refresh token.
# Set up OAuth Client ID at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_DRIVE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
